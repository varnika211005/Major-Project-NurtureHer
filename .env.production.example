PROJECT_NAME=NurtureHer
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
POSTGRES_USER=nurtureher
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=nurtureher
DATABASE_URL=postgresql+asyncpg://nurtureher:replace-with-strong-password@db:5432/nurtureher
SYNC_DATABASE_URL=postgresql://nurtureher:replace-with-strong-password@db:5432/nurtureher
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=replace-with-long-random-encryption-secret
BACKEND_CORS_ORIGINS=https://app.example.com
PCOS_MODEL_PATH=app/ml/artifacts/pcos_random_forest.pkl
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-from-number
FAST2SMS_API_KEY=replace-with-fast2sms-api-key-if-used
METRICS_ENABLED=true
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password
GUNICORN_WORKERS=4
