{
  "info": {
    "name": "NurtureHer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000/api/v1"},
    {"key": "access_token", "value": ""}
  ],
  "item": [
    {
      "name": "Health",
      "request": {"method": "GET", "url": "http://localhost:8000/health"}
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Mira\",\"email\":\"mira@example.com\",\"password\":\"Strong@123\",\"role\":\"mother\",\"preferred_language\":\"en\"}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/auth/login",
        "body": {"mode": "raw", "raw": "{\"email\":\"mira@example.com\",\"password\":\"Strong@123\"}"}
      }
    },
    {
      "name": "PCOS Predict",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{access_token}}"}
        ],
        "url": "{{base_url}}/pcos/predict",
        "body": {
          "mode": "raw",
          "raw": "{\"age\":28,\"bmi\":31,\"cycle_irregularity\":true,\"hair_growth\":true,\"skin_darkening\":false,\"weight_gain\":true,\"follicle_count\":18}"
        }
      }
    }
  ]
}

